NODE_ENV=development
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://carolsol.com.br,https://www.carolsol.com.br,https://loja.carolsol.com.br
DATABASE_URL=postgresql://universo:troque-esta-senha@localhost:5432/universo_carol_sol
SESSION_COOKIE_SECURE=false

# Armazenamento e Biblioteca de Mídias (S3 / Local)
STORAGE_DRIVER=local
UPLOAD_MAX_SIZE_MB=5
UPLOAD_DIR=public/uploads
PUBLIC_UPLOAD_PREFIX=/uploads
BACKUP_DIR=/data/backups
BACKUP_RETENTION_DAYS=14

# S3 (opcional para ativação em produção / Coolify / MinIO / R2)
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=universo-carol-sol
# S3_ACCESS_KEY=sua-access-key
# S3_SECRET_KEY=sua-secret-key
# S3_REGION=us-east-1

# SumUp Payment Gateway (Doações Projeto Elo, Loja e Academy)
SUMUP_MERCHANT_CODE=seu-merchant-code
SUMUP_API_KEY=sua-chave-secreta-sumup
SUMUP_RETURN_URL=https://carolsol.com.br/doacao/retorno
SUMUP_STORE_RETURN_URL=https://loja.carolsol.com.br/pedido
SUMUP_ACADEMY_RETURN_URL=https://academy.carolsol.com.br/aluno
ACADEMY_PUBLIC_URL=https://academy.carolsol.com.br

# Provedor de E-mail Transacional (resend | log)
EMAIL_DRIVER=log
RESEND_API_KEY=
EMAIL_FROM=Universo Carol Sol <notificacoes@carolsol.com.br>

# Provedor de WhatsApp Transacional (evolution | zapi | log)
WHATSAPP_DRIVER=log
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
